{
  "buildCommand": "cd reelforge-ai && npm install && npm run build",
  "outputDirectory": "reelforge-ai/dist",
  "framework": null,
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/generate", "destination": "/api/generate" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/generate.js": {
      "maxDuration": 60
    }
  }
}
